  "private": true,
  "main": "src/puppeteer-runtime.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node scripts/apply-puppeteer-runtime-patch.js",
    "verify": "node scripts/verify-puppeteer-runtime-patch.js",
