# Porta local onde o servidor VPS vai escutar (usada no `tailscale funnel 4400`)
PORT=4400
HOST=127.0.0.1

# URL pública HTTPS do Tailscale Funnel (SEM barra no final)
# Exemplo: https://meu-notebook.tail12345.ts.net
PUBLIC_BASE_URL=https://seu-notebook.sua-tailnet.ts.net

# Credenciais OAuth 2.0 do Google Cloud Console
# Redirect URI autorizada no Google: ${PUBLIC_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Gmails administradores iniciais (separados por vírgula)
# Eles são adicionados automaticamente na allowlist como admin ao iniciar o servidor
ADMIN_EMAILS=seuemail@gmail.com

# Duração da sessão em dias (padrão: 30)
SESSION_TTL_DAYS=30

# Caminho do banco SQLite (opcional, padrão: ./data/vigia-vps.sqlite)
# DB_PATH=./data/vigia-vps.sqlite
